# Copy this file to .env.local in the frontend directory.
# Restart the Next.js development server after changing environment values.
#
# API_MOCKING=true enables the local catalog mock outside production.
# If this is missing or false, the app uses the configured API endpoint.
API_MOCKING=true
# Local catalog scenario: default, many, or showcase.
API_MOCK_SCENARIO=showcase
# A parseable placeholder base URL is still required by the mock request builder.
# The showcase mock does not send network requests to this placeholder.
# Replace it with your actual local API base URL when API_MOCKING=false.
API_BASE_URL=http://localhost:8080
